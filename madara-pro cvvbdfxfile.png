ll\":{\"headline\":\"Passez à ChatGPT Business avec votre équipe\",\"body\":\"Découvrez ChatGPT Business et l’offre de crédits publicitaires destinée aux espaces de travail éligibles.\"},\"workspace_admin\":{\"body\":\"Demandez à un propriétaire de l’espace de travail de consulter l’offre de crédits publicitaires dans la rubrique « Avantages ».\",\"headline\":\"Aidez votre équipe à trouver des crédits publicitaires\"},\"personal\":{\"headline\":\"Passez à ChatGPT Business avec votre équipe\",\"body\":\"Découvrez l’offre pour votre équipe. Vous utilisez déjà ChatGPT Business ? Accédez à votre espace de travail.\"},\"default\":{\"headline\":\"Découvrez ChatGPT Business\",\"body\":\"En savoir plus sur les crédits publicitaires destinés aux espaces de travail éligibles.\"},\"workspace\":{\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\",\"body\":\"Un propriétaire de l’espace de travail peut consulter les offres disponibles dans la rubrique « Avantages ».\"},\"business_claim\":{\"body\":\"Connectez-vous au compte que vous utilisez pour votre espace de travail Business.\",\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\"}},\"de\":{\"default\":{\"headline\":\"Entdecke ChatGPT Business\",\"body\":\"Erfahre mehr über Werbeguthaben für berechtigte Workspaces.\"},\"business_claim\":{\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\",\"body\":\"Melde dich mit dem Konto an, das du für deinen Business-Workspace verwendest.\"},\"workspace_admin\":{\"headline\":\"Hilf deinem Team, Werbeguthaben zu finden\",\"body\":\"Bitte einen Workspace-Inhaber, unter „Vorteile“ nach dem Angebot für Werbeguthaben zu sehen.\"},\"workspace_member\":{\"headline\":\"ChatGPT Business\",\"body\":\"Wenn dein Workspace berechtigt ist, kann ein Workspace-Inhaber unter „Vorteile“ Werbeguthaben anfordern. Wähle „Weiter“, um einen separaten Business-Workspace einzurichten.\"},\"personal\":{\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\",\"body\":\"Entdecke das Angebot für dein Team. Nutzt du ChatGPT Business bereits? Wechsle zu deinem Workspace.\"},\"workspace_owner\":{\"headline\":\"Prüfe die Vorteile deines Workspaces\",\"body\":\"Öffne „Vorteile“, um zu prüfen, ob dein Workspace für Werbeguthaben berechtigt ist.\"},\"workspace\":{\"body\":\"Workspace-Inhaber können unter „Vorteile“ nach verfügbaren Angeboten sehen.\",\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\"},\"personal_upsell\":{\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\",\"body\":\"Entdecke ChatGPT Business und das Angebot für Werbeguthaben für berechtigte Workspaces.\"}},\"en\":{\"personal_upsell\":{\"headline\":\"Bring your team to Business\",\"body\":\"Explore ChatGPT Business and the ad credit offer for eligible workspaces.\"},\"workspace_owner\":{\"body\":\"Open Benefits to see whether your workspace is eligible for ad credits.\",\"headline\":\"Check your workspace benefits\"},\"workspace_admin\":{\"headline\":\"Help your team find ad credits\",\"body\":\"Ask a workspace owner to check Benefits for the ad credit offer.\"},\"default\":{\"headline\":\"Explore ChatGPT Business\",\"body\":\"Learn about ad credits for eligible workspaces.\"},\"workspace_member\":{\"body\":\"If your workspace is eligible, an owner can claim ad credits in Benefits. To set up a separate Business workspace, select Continue.\",\"headline\":\"ChatGPT Business\"},\"business_claim\":{\"body\":\"Sign in to the account you use for your Business workspace.\",\"headline\":\"Explore workspace ad credits\"},\"personal\":{\"headline\":\"Bring your team to Business\",\"body\":\"Explore the offer for your team. Already use Business? Switch to your workspace.\"},\"workspace\":{\"body\":\"A workspace owner can check Benefits for available offers.\",\"headline\":\"Explore workspace ad credits\"}},\"email_selectors\":{\"personal_upsell\":\"personal\",\"business_claim\":\"workspace\",\"parameter\":\"for\"}},{\"sentinel_timeout_ms\"